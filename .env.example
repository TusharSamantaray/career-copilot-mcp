# Copy to .env for local runs. Set real values in your host's dashboard.

# Required for HTTP. Comma-separate several keys to rotate without downtime.
CAREER_COPILOT_API_KEY=change-me-to-a-long-random-string

# Optional: header the marketplace gateway uses to identify a subscriber.
# Leave empty until the gateway's docs confirm the header name.
CAREER_COPILOT_USER_HEADER=

# Self-improvement (anonymous, aggregate usage signals)
# Random secret; without it insight hashes could be recomputed.
CAREER_COPILOT_INSIGHTS_SALT=change-me-to-another-long-random-string
# Key for GET /insights, used only by the weekly improver workflow.
CAREER_COPILOT_ADMIN_KEY=change-me-to-a-third-long-random-string
# Labels are reported only once this many distinct users sent them.
CAREER_COPILOT_K_ANON=5
# Set to 0 to turn signals off entirely.
CAREER_COPILOT_INSIGHTS=1

# Optional
PORT=8080
COPILOT_DATA_DIR=./data
CAREER_COPILOT_LOG_DIR=logs
CAREER_COPILOT_LOG_LEVEL=INFO
